{
  "name": "spp-customization",
  "version": "1.0.2",
  "kind": "theme",
  "parent": "redpanda",
  "apiVersion": 1,
  "label": "Spp Customization",
  "publisher": "Spp Customization team",
  "description": "Spp Customization: a store layout with its own font, an announcement bar, a New badge on product cards, a hero block for the page builder and a welcome page.",
  "license": "proprietary",
  "keywords": ["theme"],
  "permissions": ["routes"],
  "compatibility": { "webstore": ">=10.0.0" },
  "build": {
    "server": "src/server.tsx",
    "browser": "src/browser.tsx"
  },
  "styles": ["src/styles/*.css"],
  "dedupeStyles": true,
  "assets": ["src/assets/*.svg", "src/assets/fonts/*.woff2"],
  "messages": "src/i18n/labels.json",
  "widgets": ["SppCustomizationHero", "SppTestimonials"],
  "pages": { "/": "src/pages/home.json" },
  "serverPages": ["/spp-customization-welcome"],
  "settingsSchema": {
    "accentColor": {
      "type": "string",
      "label": "Accent color (CSS)",
      "browser": true,
      "default": "#f26b1d",
      "attribute": "ThemeAccentColor"
    },
    "announcement": {
      "type": "string",
      "label": "Announcement bar text (empty: no bar)",
      "browser": true,
      "default": "Free shipping on orders over $100"
    },
    "headingFont": {
      "type": "string",
      "label": "Heading font: brand (the theme's own Geist), family (Montserrat, from the parent theme) or system",
      "browser": true,
      "default": "brand",
      "attribute": "ThemeHeadingFont"
    },
    "logoUrl": {
      "type": "string",
      "label": "Header logo for this store (image URL; empty: the store's own logo)",
      "browser": true,
      "default": "",
      "attribute": "ThemeLogoUrl"
    },
    "supportPhone": {
      "type": "string",
      "label": "Customer service phone, shown in the announcement bar (required)",
      "required": true,
      "browser": true
    },
    "showTrustStrip": {
      "type": "boolean",
      "label": "Show the trust strip under the header",
      "browser": true,
      "default": true
    },
    "popularSearches": {
      "type": "list",
      "label": "Popular searches under the search box (up to 5)",
      "browser": true,
      "default": ["Cordless drill", "Safety glasses", "Work gloves", "Extension cord"]
    },
    "customizableSkus": {
      "type": "list",
      "label": "Decorated products: SKUs whose add-to-cart becomes \"Customize & order\" (opens the customizer)",
      "browser": true,
      "default": []
    },
    "shipCutoffHour": {
      "type": "number",
      "label": "Daily dispatch cutoff hour (0-23, warehouse time): orders before it ship the same weekday",
      "default": 15
    },
    "shipTimezone": {
      "type": "string",
      "label": "Warehouse time zone (IANA, e.g. America/New_York)",
      "default": "America/New_York"
    },
    "supportEmail": {
      "type": "string",
      "label": "Customer service email (footer help band)",
      "browser": true,
      "default": "orders@sppbrandedgoods.example"
    },
    "supportHours": {
      "type": "string",
      "label": "Customer service hours (footer help band)",
      "browser": true,
      "default": "Mon-Fri, 8am-6pm ET"
    },
    "showBadge": {
      "type": "boolean",
      "label": "Show the New badge on product cards",
      "browser": true,
      "default": true
    }
  }
}
