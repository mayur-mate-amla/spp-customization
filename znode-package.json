{
  "name": "spp-customization",
  "version": "1.0.2",
  "kind": "theme",
  "parent": "redpanda",
  "apiVersion": 1,
  "label": "Spp Customization",
  "publisher": "Spp Customization team",
  "description": "Spp Customization: a store layout with its own font, an announcement bar, a New badge on product cards, a hero block for the page builder and a welcome page.",
  "license": "proprietary",
  "keywords": ["theme"],
  "permissions": ["routes"],
  "compatibility": { "webstore": ">=10.0.0" },
  "build": {
    "server": "src/server.tsx",
    "browser": "src/browser.tsx"
  },
  "styles": ["src/styles/*.css"],
  "assets": ["src/assets/*.svg", "src/assets/fonts/*.woff2"],
  "messages": "src/i18n/labels.json",
  "widgets": ["SppCustomizationHero"],
  "pages": { "/": "src/pages/home.json" },
  "serverPages": ["/spp-customization-welcome"],
  "settingsSchema": {
    "accentColor": {
      "type": "string",
      "label": "Accent color (CSS)",
      "browser": true,
      "default": "#f26b1d",
      "attribute": "ThemeAccentColor"
    },
    "announcement": {
      "type": "string",
      "label": "Announcement bar text (empty: no bar)",
      "browser": true,
      "default": "Free shipping on orders over $100"
    },
    "headingFont": {
      "type": "string",
      "label": "Heading font: brand (the theme's own Geist), family (Montserrat, from the parent theme) or system",
      "browser": true,
      "default": "brand",
      "attribute": "ThemeHeadingFont"
    },
    "supportPhone": {
      "type": "string",
      "label": "Customer service phone, shown in the announcement bar (required)",
      "required": true,
      "browser": true
    },
    "showBadge": {
      "type": "boolean",
      "label": "Show the New badge on product cards",
      "browser": true,
      "default": true
    }
  }
}
